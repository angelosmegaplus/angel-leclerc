ANGEL_DOMAIN=angel-leclerc.fr
ANGEL_IMAGE=localhost/angel-leclerc:latest
# Valeurs utilisées par l'assistant visuel de connexion de domaine
ANGEL_PUBLIC_IPV4=
ANGEL_PUBLIC_IPV6=
ANGEL_DOMAIN_TARGET=
POSTGRES_DB=angelos
POSTGRES_USER=angelos
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://angelos:change-me@angel-postgres:5432/angelos
ANGEL_DATA_URL=http://angel-data:3100
ANGEL_DATA_TOKEN=change-me-with-a-long-random-token
ANGEL_IDENTITY_URL=http://angel-identity:3200
ANGEL_IDENTITY_TOKEN=change-me-with-a-second-long-random-token
ANGEL_IDENTITY_SESSION_DAYS=30
ANGEL_IDENTITY_ADMIN_EMAIL=
ANGEL_IDENTITY_ADMIN_PASSWORD=
ANGEL_STORAGE_URL=http://angel-storage:3300
ANGEL_STORAGE_TOKEN=change-me-with-a-third-long-random-token
ANGEL_STORAGE_PATH=/var/lib/angel-os/storage
ANGEL_JOBS_URL=http://angel-jobs:3400
ANGEL_JOBS_TOKEN=change-me-with-a-fourth-long-random-token
ANGEL_JOBS_INTERVAL_MS=300000
# Fournisseurs optionnels / compatibilité pendant la migration
GITHUB_TOKEN=
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_ORG_ID=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
