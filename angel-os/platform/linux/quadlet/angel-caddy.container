[Unit]
Description=Angel OS Caddy reverse proxy
Requires=angel-app.service
After=angel-app.service

[Container]
Image=docker.io/library/caddy:2-alpine
ContainerName=angel-caddy
Network=angel-network.network
Volume=/etc/angel-os/Caddyfile:/etc/caddy/Caddyfile:ro
Volume=angel-caddy-data.volume:/data
PublishPort=80:80
PublishPort=443:443

[Service]
Restart=always

[Install]
WantedBy=default.target
