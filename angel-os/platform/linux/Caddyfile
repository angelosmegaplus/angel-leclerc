{
  admin off
  email admin@angel-leclerc.fr
}

angel-leclerc.fr, www.angel-leclerc.fr {
  encode zstd gzip
  reverse_proxy angel-app:3000
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
  }
  log {
    output stdout
    format console
  }
}
