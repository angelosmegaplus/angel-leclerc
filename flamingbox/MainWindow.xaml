<Window x:Class="FlamingBox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlamingBox — Angel OS Browser" Height="850" Width="1400"
        MinHeight="600" MinWidth="900" Background="#101014">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#17171D" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="BackButton" Content="←" Width="40" Height="36" Margin="0,0,6,0" Click="Back_Click"/>
                <Button Grid.Column="1" x:Name="ForwardButton" Content="→" Width="40" Height="36" Margin="0,0,6,0" Click="Forward_Click"/>
                <Button Grid.Column="2" Content="⟳" Width="40" Height="36" Margin="0,0,8,0" Click="Reload_Click"/>

                <TextBox Grid.Column="3" x:Name="AddressBox" Height="36" VerticalContentAlignment="Center" FontSize="15"
                         Background="#25252D" Foreground="White" BorderBrush="#3A3A44" Padding="12,0"
                         KeyDown="AddressBox_KeyDown"/>

                <Button Grid.Column="4" Content="🔐 Google Passwords" Height="36" Margin="8,0,0,0" Padding="12,0" Click="GooglePasswords_Click"/>
                <Button Grid.Column="5" Content="+" Width="40" Height="36" Margin="8,0,0,0" Click="NewTab_Click"/>
                <Button Grid.Column="6" Content="×" Width="40" Height="36" Margin="6,0,0,0" Click="CloseTab_Click"/>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#17171D" Padding="8,5">
            <TextBlock x:Name="StatusText" Foreground="#C6C6D0" Text="FlamingBox Shield actif — Angel OS security layer"/>
        </Border>

        <TabControl x:Name="Tabs" Background="#101014" BorderThickness="0" SelectionChanged="Tabs_SelectionChanged"/>
    </DockPanel>
</Window>
