{
  "name": "flamingbox",
  "version": "0.2.0",
  "description": "FlamingBox - navigateur Windows léger basé sur Chromium via NW.js, avec onglets, favoris, historique, navigation privée et import Firefox/Chrome/Edge/Chromium.",
  "main": "src/index.html",
  "nodejs": true,
  "node-remote": [],
  "chromium-args": "--enable-features=OverlayScrollbar --disable-features=TranslateUI --disable-breakpad",
  "window": {
    "title": "FlamingBox",
    "width": 1440,
    "height": 900,
    "min_width": 900,
    "min_height": 600,
    "position": "center",
    "frame": true,
    "toolbar": false,
    "resizable": true
  },
  "permissions": [
    "<all_urls>",
    "storage",
    "unlimitedStorage",
    "webRequest",
    "webRequestBlocking"
  ]
}
