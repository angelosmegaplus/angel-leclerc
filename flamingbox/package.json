{
  "name": "flamme",
  "version": "0.7.0",
  "description": "Flamme 0.7 — navigateur français basé presque entièrement sur Chromium, avec recherche Qwant et portail de services numériques français.",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "fr.angelos.flamme",
    "productName": "Flamme",
    "asar": true,
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "Flamme-${version}-Windows-x64.${ext}"
    }
  }
}
