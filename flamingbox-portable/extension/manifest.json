{
  "manifest_version": 3,
  "name": "FlamingBox Protection",
  "version": "1.0.0",
  "description": "Protection locale FlamingBox utilisant le moteur declarativeNetRequest natif de Chromium.",
  "permissions": [
    "declarativeNetRequest",
    "storage"
  ],
  "host_permissions": ["<all_urls>"],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "flamingbox_balanced",
        "enabled": true,
        "path": "rules-balanced.json"
      }
    ]
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_title": "FlamingBox Protection"
  }
}
